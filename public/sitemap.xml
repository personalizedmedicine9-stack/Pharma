  return [
    { url: 'https://phytoinsight.com/', lastModified: lastmod, changeFrequency: 'weekly', priority: 1.0 },
    { url: 'https://phytoinsight.com/interaction', lastModified: lastmod, changeFrequency: 'weekly', priority: 0.9 },
    { url: 'https://phytoinsight.com/pharmacology', lastModified: lastmod, changeFrequency: 'weekly', priority: 0.9 },
    { url: 'https://phytoinsight.com/herbinsight', lastModified: lastmod, changeFrequency: 'weekly', priority: 0.9 },
    { url: 'https://phytoinsight.com/structure', lastModified: lastmod, changeFrequency: 'weekly', priority: 0.9 },
    { url: 'https://phytoinsight.com/methodology', lastModified: lastmod, changeFrequency: 'monthly', priority: 0.8 },
    { url: 'https://phytoinsight.com/about', lastModified: lastmod, changeFrequency: 'monthly', priority: 0.5 },
    { url: 'https://phytoinsight.com/contact', lastModified: lastmod, changeFrequency: 'monthly', priority: 0.5 },
    { url: 'https://phytoinsight.com/privacy', lastModified: lastmod, changeFrequency: 'yearly', priority: 0.3 },
